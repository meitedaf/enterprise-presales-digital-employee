{
  "type": "object",
  "properties": {
    "risk_check_result": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "blocked"
          ]
        },
        "must_block_output": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_type": {
                "type": "string",
                "enum": [
                  "over_commitment",
                  "unsupported_claim",
                  "support_level_mismatch",
                  "missing_dependency",
                  "missing_human_confirmation",
                  "missing_risk_note",
                  "unsafe_expression",
                  "evidence_mismatch",
                  "format_issue",
                  "other"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "original_text": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "suggested_fix": {
                "type": "string"
              }
            },
            "required": [
              "issue_type",
              "severity",
              "original_text",
              "reason",
              "suggested_fix"
            ]
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "passed",
        "risk_level",
        "must_block_output",
        "issues",
        "summary"
      ]
    },
    "final_safe_response": {
      "type": "string"
    }
  },
  "required": [
    "risk_check_result",
    "final_safe_response"
  ]
}