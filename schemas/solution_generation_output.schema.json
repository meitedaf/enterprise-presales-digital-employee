                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "dependency": {
                "type": "string"
              },
              "customer_required_inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "risk_note": {
                "type": "string"
              }
