          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_confirmation_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
