              },
              "description": {
                "type": "string"
              },
              "safe_expression": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_basis": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "capability",
              "support_level",
              "description",
              "safe_expression",
              "dependencies",
              "boundaries",
              "evidence_basis"
            ]
          }
        },
        "integration_plan": {
          "type": "array",
