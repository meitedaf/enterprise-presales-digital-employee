{
  "type": "object",
  "properties": {
    "evidence_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_item": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "evidence_found": {
            "type": "boolean"
          },
          "evidence_quality": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "none",
              "conflicting"
            ]
          },
          "support_summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_doc": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "evidence_type": {
                  "type": "string",
                  "enum": [
                    "product_capability",
                    "technical_solution",
                    "delivery_boundary",
                    "case_reference",
                    "faq",
                    "unknown"
                  ]
                },
                "limitations_or_conditions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "source_doc",
                "quote",
                "evidence_type",
                "limitations_or_conditions"
              ]
            }
          },
          "technical_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieval_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "possible_conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended_next_step": {
            "type": "string"
          }
        },
        "required": [
          "requirement_item",
          "query",
          "evidence_found",
          "evidence_quality",
          "support_summary",
          "evidence",
          "technical_dependencies",
          "retrieval_gaps",
          "possible_conflicts",
          "recommended_next_step"
        ]
      }
    },
    "retrieval_summary": {
      "type": "object",
      "properties": {
        "strong_evidence_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weak_evidence_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_evidence_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicting_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "need_human_confirmation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_next_step": {
          "type": "string"
        }
      },
      "required": [
        "strong_evidence_items",
        "weak_evidence_items",
        "no_evidence_items",
        "conflicting_items",
        "need_human_confirmation",
        "recommended_next_step"
      ]
