{"id":"RC-001","name":"信息不足-泛化提效需求","input":"我们想做一个 AI 系统，帮助业务提效。","expected":{"route_decision":"need_follow_up","must_missing_fields":["scenario","target_users","functional_requirements","deployment_requirement","integration_requirements"],"search_questions_empty":true},"checks":["route_decision_should_be_need_follow_up","should_not_generate_search_questions","should_generate_clarification_questions","should_not_assume_missing_fields"]}
{"id":"RC-002","name":"信息充分-零售AI客服需求","input":"客户是一家连锁零售企业，想做 AI 客服，目标是降低人工客服重复咨询压力。使用对象是消费者和客服坐席。需要支持商品咨询、订单状态查询、退换货政策问答和投诉转人工。希望私有化部署，并需要对接订单系统和现有客服系统。","expected":{"route_decision":"technical_matching","missing_fields_empty":true,"must_extract":{"business_goal":"降低人工客服重复咨询压力","scenario":"AI客服","deployment_requirement":"私有化部署"},"must_include_functional_requirements":["商品咨询","订单状态查询","退换货政策问答","投诉转人工"],"must_include_integration_requirements":["订单系统","现有客服系统"],"search_questions_required":true},"checks":["route_decision_should_be_technical_matching","should_extract_required_fields","should_generate_search_questions","should_generate_one_question_per_requirement_item"]}
{"id":"RC-003","name":"缺部署方式","input":"客户是一家零售企业，想做 AI 客服，目标是减少客服重复咨询。使用对象是消费者和客服坐席。需要支持商品咨询、订单查询和退换货政策问答，并对接订单系统。","expected":{"route_decision":"need_follow_up","must_missing_fields":["deployment_requirement"],"search_questions_empty":true},"checks":["should_ask_deployment_requirement","should_not_enter_technical_matching"]}
{"id":"RC-004","name":"缺系统对接需求","input":"客户是一家零售企业，想做 AI 客服，目标是减少客服重复咨询。使用对象是消费者和客服坐席。需要支持商品咨询、订单查询和退换货政策问答，希望私有化部署。","expected":{"route_decision":"need_follow_up","must_missing_fields":["integration_requirements"],"search_questions_empty":true},"checks":["should_ask_integration_requirements","should_not_assume_order_system_integration"]}
{"id":"RC-005","name":"口语化表达标准化","input":"客户是连锁零售企业，想上一个客服机器人，主要给买东西的用户用，目标是减少人工重复回复。功能上要能问商品、查订单进度、问退货规则，遇到投诉能接人工。希望私有化，还要连他们自己的订单系统和客服系统。","expected":{"route_decision":"technical_matching","must_include_functional_requirements":["商品咨询","订单状态查询","退换货政策问答","转人工"],"must_include_integration_requirements":["订单系统","客服系统"],"search_questions_required":true},"checks":["should_standardize_colloquial_terms","should_generate_search_questions"]}
{"id":"RC-006","name":"不得自行假设目标用户","input":"客户是一家零售企业，想做 AI 客服，目标是降低人工客服压力。需要支持商品咨询和订单查询。希望私有化部署，并对接订单系统。","expected":{"route_decision":"need_follow_up","must_missing_fields":["target_users"],"search_questions_empty":true},"checks":["should_not_assume_target_users"]}
{"id":"RC-007","name":"多轮追问补齐需求","type":"multi_turn","turns":[{"turn_id":1,"input":"我们想做 AI 客服，降低客服压力。","expected":{"route_decision":"need_follow_up","must_extract":{"business_goal":"降低客服压力"},"must_missing_fields":["target_users","functional_requirements","deployment_requirement","integration_requirements"],"search_questions_empty":true,"should_generate_clarification_questions":true,"state_should_persist":["business_goal"]}},{"turn_id":2,"input":"主要给消费者和客服坐席使用，需要商品咨询和订单查询，私有化部署，并对接订单系统。","expected":{"route_decision":"technical_matching","missing_fields_empty":true,"clarification_questions_empty":true,"must_extract":{"business_goal":"降低客服压力","scenario":"AI客服","deployment_requirement":"私有化部署"},"must_include_target_users":["消费者","客服坐席"],"must_include_functional_requirements":["商品咨询","订单状态查询"],"must_include_integration_requirements":["订单系统"],"must_not_extract":{"scenario":["商品咨询和订单查询","商品咨询","订单查询"],"functional_requirements":["AI客服","智能客服","客服机器人"]},"search_questions_required":true,"search_questions_should_cover":["商品咨询","订单状态查询","私有化部署","订单系统"]}}],"checks":["should_support_multi_turn_requirement_completion","should_persist_previous_business_goal","should_merge_current_user_supplement_with_requirement_state","should_not_reset_structured_requirement_on_second_turn","should_not_mix_scenario_with_functional_requirements","should_not_put_ai_customer_service_into_functional_requirements","should_generate_search_questions_after_all_required_fields_complete","should_route_to_need_follow_up_first_then_technical_matching"]}